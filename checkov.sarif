 }\n\n  root_block_device {\n    volume_size = 20\n    encrypted   = true\n  }\n\n  user_data = <<-EOT\n    #!/bin/bash\n    set -euxo pipefail\n    dnf install -y docker git\n    systemctl enable --now docker\n    mkdir -p /usr/local/lib/docker/cli-plugins\n    curl -sSL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 \\\n      -o /usr/local/lib/docker/cli-plugins/docker-compose\n    chmod +x /usr/local/lib/docker/cli-plugins/docker-compose\n    git clone --depth 1 https://github.com/testifysec/cloudvault-api.git /opt/cloudvault\n    cd /opt/cloudvault\n    docker compose up -d --build\n  EOT\n\n  tags = { Name = \"${local.name}-app\" }\n}\n"}}}}]}, {"ruleId": "CKV_AWS_126", "ruleIndex": 3, "level": "error", "attachments": [], "message": {"text": "Ensure that detailed monitoring is enabled for EC2 instances"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "terraform/demo/app.tf"}, "region": {"startLine": 44, "endLine": 76, "snippet": {"text": "resource \"aws_instance\" \"app\" {\n  ami                         = data.aws_ami.al2023.id\n  instance_type               = \"t3.small\"\n  subnet_id                   = module.vpc.public_subnet_ids[0]\n  vpc_security_group_ids      = [aws_security_group.app.id]\n  iam_instance_profile        = aws_iam_instance_profile.app.name\n  associate_public_ip_address = true\n\n  metadata_options {\n    http_tokens = \"required\"\n  }\n\n  root_block_device {\n    volume_size = 20\n    encrypted   = true\n  }\n\n  user_data = <<-EOT\n    #!/bin/bash\n    set -euxo pipefail\n    dnf install -y docker git\n    systemctl enable --now docker\n    mkdir -p /usr/local/lib/docker/cli-plugins\n    curl -sSL https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64 \\\n      -o /usr/local/lib/docker/cli-plugins/docker-compose\n    chmod +x /usr/local/lib/docker/cli-plugins/docker-compose\n    git clone --depth 1 https://github.com/testifysec/cloudvault-api.